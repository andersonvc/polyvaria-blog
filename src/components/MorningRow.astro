---
/*
  One morning, from the record, as a single row: a dataset the firm did
  not have, from the ask to serving, with nobody in the path.

  The steps are evenly spaced, one per column, because the first five
  happen inside half an hour and a true time axis would crush them; the
  time is printed over each.
*/
const STEPS = [
  { t: "09:04", team: "Research pod", verb: "Ask", note: "in plain English" },
  { t: "09:05", team: "Front door", verb: "Search", note: "the catalog" },
  { t: "09:07", team: "Front door", verb: "Probe", note: "a vendor sample" },
  { t: "09:12", team: "Onboarding", verb: "Write", note: "the ingestion code" },
  { t: "09:31", team: "Onboarding", verb: "Gate", note: "no lookahead" },
  { t: "11:46", team: "The lake", verb: "Backfill", note: "history to 2010" },
  { t: "13:58", team: "The lake", verb: "Serve", note: "live in the catalog" },
] as const;
---

<figure class="mrow" data-reveal>
  <figcaption>
    <p class="mrow__elapsed">4<small>h</small> 54<small>min</small></p>
    <p class="mrow__say">
      A researcher asks for data the firm does not have. Under five hours later it is onboarded, proven unable to see the
      future, and serving. <span>No human in the path.</span>
    </p>
  </figcaption>

  <ol class="mrow__rail">
    {
      STEPS.map((s, i) => (
        <li style={`--i:${i}`}>
          <span class="mrow__time mono">{s.t}</span>
          <span class="mrow__node" aria-hidden="true" />
          <span class="mrow__verb">{s.verb}</span>
          <span class="mrow__note">{s.note}</span>
          <span class="mrow__team label">{s.team}</span>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .mrow {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    align-items: center;
    gap: clamp(1.6rem, 3.5vw, 3.5rem);
    padding-top: clamp(1.1rem, 1.8vw, 1.5rem);
    border-top: 1px solid var(--rule);
  }

  figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.3rem;
  }

  .mrow__elapsed {
    font-family: var(--display);
    font-size: clamp(1.9rem, 1.3rem + 1.7vw, 2.7rem);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--copper);
    font-variant-numeric: lining-nums;
  }

  .mrow__elapsed small {
    font-size: 0.42em;
    letter-spacing: 0;
    margin: 0 0.16em 0 0.06em;
    color: var(--ink-2);
  }

  .mrow__say {
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .mrow__say span {
    color: var(--ink);
  }

  /* The rail: seven steps on one copper line. */
  .mrow__rail {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  li {
    position: relative;
    display: grid;
    justify-items: start;
    align-content: start;
    padding-right: 0.6rem;
  }

  .mrow__time {
    height: 1rem;
    font-size: 0.74rem;
    line-height: 1rem;
    color: var(--copper);
  }

  .mrow__node {
    position: relative;
    z-index: 1;
    width: 0.6rem;
    height: 0.6rem;
    margin: 0.5rem 0 0.55rem;
    border-radius: 50%;
    background: var(--copper);
    box-shadow: 0 0 0 3px var(--paper);
  }

  /* The line from this step to the next. */
  li::before {
    content: "";
    position: absolute;
    left: 0.3rem;
    right: -0.3rem;
    top: calc(1.8rem - 0.5px);
    height: 1px;
    background: var(--copper-mark);
    transform-origin: left;
  }

  li:last-child::before {
    display: none;
  }

  li:last-child .mrow__node {
    background: var(--paper);
    box-shadow:
      inset 0 0 0 2px var(--copper),
      0 0 0 3px var(--paper);
  }

  .mrow__verb {
    font-family: var(--display);
    font-size: 1.15rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .mrow__note {
    margin-top: 0.15rem;
    font-size: 0.76rem;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .mrow__team {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    letter-spacing: 0.09em;
  }

  /* The steps arrive in order as the row comes into view. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .mrow li {
      opacity: 0;
    }

    :global(.js) .mrow li::before {
      transform: scaleX(0);
    }

    :global(.js) .mrow.is-in li {
      opacity: 1;
      transition: opacity 0.5s ease calc(0.3s + var(--i) * 0.28s);
    }

    :global(.js) .mrow.is-in li::before {
      transform: none;
      transition: transform 0.35s ease calc(0.45s + var(--i) * 0.28s);
    }
  }

  @media (max-width: 74rem) {
    .mrow {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* On a narrow screen the rail runs down the page. */
  @media (max-width: 46rem) {
    figcaption {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }

    .mrow__rail {
      grid-template-columns: minmax(0, 1fr);
      border-top: 1px solid var(--rule-faint);
    }

    /* One line a step: the time, the verb, and what it acted on. */
    li {
      grid-template-columns: 3.2rem 4.6rem minmax(0, 1fr);
      column-gap: 0.7rem;
      align-items: baseline;
      padding: 0.5rem 0 0.55rem;
      border-bottom: 1px solid var(--rule-faint);
    }

    li::before,
    .mrow__node,
    .mrow__team {
      display: none;
    }

    .mrow__time {
      height: auto;
      line-height: inherit;
    }

    .mrow__note {
      margin-top: 0;
      font-size: 0.86rem;
    }
  }
</style>
