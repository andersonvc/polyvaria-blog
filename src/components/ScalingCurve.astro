---
/*
  The wall. Research breadth against the number of researchers a firm
  can field, both on log scales. A human fund's breadth follows its
  headcount until hiring and coordination stop it. A firm of agents
  keeps to the diagonal.

  A schematic: the shape is the claim, and no value is read off it.
  The curves are computed, not drawn. It is set small, beside the pod.
*/
const W = 360;
const H = 372;
const M = { l: 34, r: 14, t: 20, b: 44 };
const PW = W - M.l - M.r;
const PH = H - M.t - M.b;

const LO = 1; // 10
const HI = 4.18; // about 15,000
const sx = (n: number) => M.l + ((Math.log10(n) - LO) / (HI - LO)) * PW;
const sy = (v: number) => H - M.b - ((Math.log10(v) - LO) / (HI - LO)) * PH;

const path = (f: (n: number) => number, from: number, to: number) => {
  const pts: string[] = [];
  const steps = 60;
  for (let i = 0; i <= steps; i++) {
    const n = 10 ** (Math.log10(from) + ((Math.log10(to) - Math.log10(from)) * i) / steps);
    pts.push(`${sx(n).toFixed(1)} ${sy(f(n)).toFixed(1)}`);
  }
  return `M${pts.join(" L")}`;
};

/* A human fund: breadth saturates as the firm grows. */
const human = (n: number) => 10 + (n - 10) / (1 + (n / 95) ** 1.25);
const WALL = 560;
const GOAL = 10_000;

const humanPath = path(human, 10, WALL);
const ours = path((n) => n, 10, GOAL);

const ticks = [10, 100, 1_000, 10_000];
const wallX = sx(WALL);
const hatch = Array.from({ length: 19 }, (_, i) => {
  const y = M.t + 6 + i * ((PH - 2) / 18);
  return `M${wallX.toFixed(1)} ${y.toFixed(1)} l9 -9`;
}).join(" ");
---

<figure class="curve" data-reveal>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="curve-title curve-desc">
    <title id="curve-title">Research breadth against researchers on the floor</title>
    <desc id="curve-desc">
      Two lines on a chart of research breadth against the number of researchers a firm fields. A human fund's line rises
      with headcount, bends flat and stops at a wall marked hiring and coordination, a few hundred researchers in.
      Polyvaria's line keeps rising in a straight line to ten thousand.
    </desc>

    {ticks.map((n) => <line class="curve__grid" x1={sx(n)} x2={sx(n)} y1={M.t} y2={H - M.b} />)}
    <path class="curve__axis" d={`M${M.l} ${M.t - 4} V${H - M.b} H${W - M.r + 4}`}></path>

    {
      ticks.map((n) => (
        <text class="curve__tick" x={sx(n)} y={H - M.b + 17} text-anchor="middle">
          {n.toLocaleString("en-US")}
        </text>
      ))
    }
    <text class="curve__label" x={M.l + PW / 2} y={H - 6} text-anchor="middle">Researchers on the floor</text>
    <text class="curve__label" transform={`translate(${M.l - 14} ${M.t + PH / 2}) rotate(-90)`} text-anchor="middle">Research breadth</text>

    <!-- the wall -->
    <line class="curve__wall" x1={wallX} x2={wallX} y1={M.t - 4} y2={H - M.b}></line>
    <path class="curve__hatch" d={hatch}></path>
    <text class="curve__note curve__note--wall" x={wallX + 15} y={H - M.b - 36}>The wall:</text>
    <text class="curve__note curve__note--wall" x={wallX + 15} y={H - M.b - 19}>hiring, coordination</text>

    <!-- a human fund -->
    <path class="curve__human" d={humanPath} pathLength="1"></path>
    <circle class="curve__stop" cx={wallX} cy={sy(human(WALL))} r="4"></circle>
    <text class="curve__note" x={wallX - 10} y={sy(human(WALL)) + 44} text-anchor="end">A human fund</text>

    <!-- Polyvaria -->
    <path class="curve__ours" d={ours} pathLength="1"></path>
    <circle class="curve__goal" cx={sx(GOAL)} cy={sy(GOAL)} r="5"></circle>
    <text class="curve__name" x={sx(GOAL) - 15} y={sy(GOAL) + 5} text-anchor="end">Polyvaria</text>
  </svg>
  <figcaption>Models scaled with compute. <span>Institutions scale with agents.</span></figcaption>
</figure>

<style>
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .curve__grid {
    stroke: var(--rule-faint);
    stroke-width: 1;
  }

  .curve__axis {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1;
  }

  .curve__tick {
    font-family: var(--mono);
    font-size: 11.5px;
    fill: var(--ink-3);
  }

  .curve__label {
    font-family: var(--serif);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--ink-3);
  }

  .curve__wall {
    stroke: var(--ink-2);
    stroke-width: 1.2;
  }

  .curve__hatch {
    stroke: var(--ink-3);
    stroke-width: 1;
    opacity: 0.7;
  }

  .curve__human {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .curve__stop {
    fill: var(--paper);
    stroke: var(--ink-2);
    stroke-width: 1.5;
  }

  .curve__ours {
    fill: none;
    stroke: var(--copper);
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  .curve__goal {
    fill: var(--paper);
    stroke: var(--copper);
    stroke-width: 2;
  }

  .curve__note {
    font-family: var(--serif);
    font-size: 14.5px;
    fill: var(--ink-2);
  }

  .curve__note--wall {
    fill: var(--ink-3);
    font-size: 13.5px;
  }

  .curve__name {
    font-family: var(--display);
    font-size: 23px;
    letter-spacing: -0.01em;
    fill: var(--ink);
  }

  figcaption {
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule);
    font-family: var(--display);
    font-size: 1.08rem;
    line-height: 1.3;
    letter-spacing: -0.008em;
    color: var(--ink-3);
  }

  figcaption span {
    display: block;
    color: var(--ink);
  }

  /* The lines are drawn as the chart comes into view: the human fund first, to its wall, then ours past it. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .curve .curve__human,
    :global(.js) .curve .curve__ours {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(.js) .curve .curve__goal,
    :global(.js) .curve .curve__name,
    :global(.js) .curve .curve__stop {
      opacity: 0;
    }

    :global(.js) .curve.is-in .curve__human {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.2s cubic-bezier(0.3, 0.6, 0.2, 1) 0.3s;
    }

    :global(.js) .curve.is-in .curve__stop {
      opacity: 1;
      transition: opacity 0.4s ease 1.4s;
    }

    :global(.js) .curve.is-in .curve__ours {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.8s cubic-bezier(0.3, 0.6, 0.2, 1) 1.5s;
    }

    :global(.js) .curve.is-in .curve__goal,
    :global(.js) .curve.is-in .curve__name {
      opacity: 1;
      transition: opacity 0.7s ease 3.1s;
    }
  }
</style>
