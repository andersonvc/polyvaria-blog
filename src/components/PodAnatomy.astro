---
/*
  One pod. A person sets what it pursues. A principal investigator
  decides how, and directs a swarm of researchers. Every result crosses
  to the referee and comes back signed. Three things can leave the
  investigator: one more turn, a candidate, or a kill.

  The researchers are placed by a seeded generator, clear of the axes
  the lines run on; nothing is positioned by hand.
*/
const W = 500;
const H = 520;
const CX = 200;
const CY = 264;
const POD = 126;

/* A small seeded generator, so the drawing is the same on every build. */
let seed = 0x9e3779b9;
const rnd = () => {
  seed |= 0;
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

/* Bearings kept clear, in degrees clockwise from the right: the referee, the kill, the loop, the leader, the mandate. */
const CLEAR: [number, number][] = [
  [0, 18],
  [90, 15],
  [180, 35],
  [224, 8],
  [270, 17],
];
const open = (deg: number) => CLEAR.every(([at, half]) => Math.abs(((deg - at + 540) % 360) - 180) > half);

interface Researcher {
  x: number;
  y: number;
  k: number;
}
const researchers: Researcher[] = [];
for (let tries = 0; researchers.length < 26 && tries < 6000; tries++) {
  const deg = rnd() * 360;
  if (!open(deg)) continue;
  const r = 52 + rnd() ** 0.75 * 58;
  const x = CX + r * Math.cos((deg * Math.PI) / 180);
  const y = CY + r * Math.sin((deg * Math.PI) / 180);
  if (researchers.some((p) => Math.hypot(p.x - x, p.y - y) < 20)) continue;
  researchers.push({ x, y, k: researchers.length % 4 });
}
const spokes = researchers.map((p) => `M${CX} ${CY}L${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join("");

/** An open arrowhead whose tip is at (x, y), pointing along (dx, dy). */
const head = (x: number, y: number, dx: number, dy: number, size = 6.5) => {
  const l = Math.hypot(dx, dy);
  const ux = dx / l;
  const uy = dy / l;
  const barb = (sign: number) => {
    const c = Math.cos(0.5 * sign);
    const s = Math.sin(0.5 * sign);
    return `${(x - (ux * c - uy * s) * size).toFixed(1)} ${(y - (ux * s + uy * c) * size).toFixed(1)}`;
  };
  return `M${barb(1)}L${x} ${y}L${barb(-1)}`;
};

const YOU = 28;
const TOP = YOU + 18;
const CORE = 20;
const REF = { x: 388, y: CY - 35, w: 108, h: 70 };
const DEAD = CY + POD + 74;

const mandate = `M${CX - 7} ${TOP}V${CY - CORE}`;
const candidate = `M${CX + 7} ${CY - CORE}V${TOP}`;
const result = `M${CX + CORE} ${CY - 7}H${REF.x}`;
const verdict = `M${REF.x} ${CY + 7}H${CX + CORE}`;
const kill = `M${CX} ${CY + CORE}V${DEAD - 10}`;
const loop = `M${CX - 18} ${CY - 7}C${CX - 54} ${CY - 38} ${CX - 100} ${CY - 25} ${CX - 100} ${CY}C${CX - 100} ${CY + 25} ${CX - 54} ${CY + 38} ${CX - 18} ${CY + 7}`;

/* The researcher the label points at: the one nearest the lower left. */
const pointed = researchers.reduce((best, p) => (p.x - p.y * 0.9 < best.x - best.y * 0.9 ? p : best));

const DEAD_ROWS = [46, 26, 52];
---

<figure class="pod" data-reveal>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="pod-fig-title pod-fig-desc">
    <title id="pod-fig-title">The anatomy of a research pod</title>
    <desc id="pod-fig-desc">
      A person at the top sends a mandate down to a principal investigator at the centre of a pod. Researchers stand round
      the investigator, each joined to it. Results cross from the pod to a referee outside it and come back as signed
      verdicts. Three paths leave the investigator: a loop back into the pod marked iterate, an arrow up to the person marked
      candidate, and an arrow down to a dead list marked kill.
    </desc>

    <!-- the pod -->
    <circle class="pod__bound" cx={CX} cy={CY} r={POD}></circle>
    <text class="pod__caps" x={CX + 94} y={CY - 100}>The pod</text>
    <path class="pod__spokes" d={spokes}></path>
    {researchers.map((p) => <circle class="pod__agent" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="3.8" style={`--k:${p.k}`} />)}

    <!-- you, the mandate and the candidate -->
    <circle class="pod__you" cx={CX} cy={YOU} r="7.5"></circle>
    <text class="pod__name" x={CX + 20} y={YOU - 1}>You</text>
    <text class="pod__note" x={CX + 20} y={YOU + 16}>set what the pod pursues</text>
    <path class="pod__line" d={mandate}></path>
    <path class="pod__line" d={head(CX - 7, CY - CORE, 0, 1)}></path>
    <text class="pod__way" x={CX - 18} y="96" text-anchor="end">mandate</text>
    <path class="pod__line pod__line--live" d={candidate}></path>
    <path class="pod__line pod__line--live" d={head(CX + 7, TOP, 0, -1)}></path>
    <text class="pod__way pod__way--live" x={CX + 18} y="96">candidate</text>

    <!-- the referee, outside the pod -->
    <rect class="pod__room" x={REF.x} y={REF.y} width={REF.w} height={REF.h}></rect>
    <text class="pod__name" x={REF.x + REF.w / 2} y={CY - 3} text-anchor="middle">Referee</text>
    <text class="pod__note" x={REF.x + REF.w / 2} y={CY + 16} text-anchor="middle">signs verdicts</text>
    <path class="pod__line pod__line--door" d={result}></path>
    <path class="pod__line pod__line--door" d={head(REF.x, CY - 7, 1, 0)}></path>
    <path class="pod__line pod__line--door" d={verdict}></path>
    <path class="pod__line pod__line--door" d={head(CX + CORE, CY + 7, -1, 0)}></path>
    <text class="pod__way" x={(CX + POD + REF.x) / 2} y={CY - 15} text-anchor="middle">result</text>
    <text class="pod__way" x={(CX + POD + REF.x) / 2} y={CY + 25} text-anchor="middle">signed</text>
    <path class="pod__run" d={`${result}`} pathLength="1"></path>
    <path class="pod__run pod__run--back" d={`${verdict}`} pathLength="1"></path>

    <!-- one more turn -->
    <path class="pod__line" d={loop}></path>
    <path class="pod__line" d={head(CX - 18, CY + 7, 36, -31)}></path>
    <text class="pod__way" x={CX - 61} y={CY + 4} text-anchor="middle">iterate</text>
    <path class="pod__run pod__run--loop" d={loop} pathLength="1"></path>

    <!-- the kill, and the dead list -->
    <path class="pod__line pod__line--kill" d={kill}></path>
    <path class="pod__line pod__line--kill" d={head(CX, DEAD - 10, 0, 1)}></path>
    <text class="pod__way pod__way--kill" x={CX + 12} y={CY + POD + 34}>kill</text>
    {
      DEAD_ROWS.map((len, i) => (
        <g>
          <path class="pod__cross" d={`M${CX - 58} ${DEAD + i * 16 - 3}l6 6m0 -6l-6 6`} />
          <line class="pod__dead" x1={CX - 44} x2={CX - 44 + len + 44} y1={DEAD + i * 16} y2={DEAD + i * 16} />
        </g>
      ))
    }
    <text class="pod__name" x={CX + 76} y={DEAD + 11}>Dead list</text>
    <text class="pod__note" x={CX + 76} y={DEAD + 29}>never tested twice</text>

    <!-- the investigator -->
    <circle class="pod__halo" cx={CX} cy={CY} r={CORE - 3}></circle>
    <circle class="pod__pi" cx={CX} cy={CY} r="9"></circle>
    <path class="pod__leader" d={`M${CX - 14} ${CY - 13.5}L${CX - 98} ${CY - 94.5}`}></path>
    <text class="pod__name" x="2" y={CY - 138}>Principal</text>
    <text class="pod__name" x="2" y={CY - 119}>investigator</text>
    <text class="pod__note" x="2" y={CY - 101}>decides how</text>

    <path class="pod__leader" d={`M92 ${CY + 131}L${(pointed.x - 6).toFixed(1)} ${(pointed.y + 6).toFixed(1)}`}></path>
    <text class="pod__name" x="2" y={CY + 142}>Researchers</text>
    <text class="pod__note" x="2" y={CY + 160}>one brief each</text>
  </svg>
</figure>

<style>
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .pod__bound {
    fill: var(--paper-raise);
    stroke: var(--ink-3);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }

  .pod__spokes {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
  }

  .pod__agent {
    fill: var(--ink);
  }

  .pod__you {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  .pod__pi {
    fill: var(--copper);
  }

  .pod__halo {
    fill: var(--paper-raise);
    stroke: var(--copper-mark);
    stroke-width: 1;
  }

  .pod__room {
    fill: var(--paper-raise);
    stroke: var(--ink-3);
    stroke-width: 1;
  }

  .pod__line {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pod__line--live {
    stroke: var(--copper);
  }

  .pod__line--door {
    stroke: var(--copper-mark);
  }

  .pod__line--kill {
    stroke: var(--red);
  }

  .pod__leader {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 0.8;
  }

  .pod__cross {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .pod__dead {
    stroke: var(--ink-3);
    stroke-width: 1;
  }

  .pod__name {
    font-family: var(--display);
    font-size: 18px;
    letter-spacing: -0.01em;
    fill: var(--ink);
  }

  .pod__note {
    font-family: var(--serif);
    font-size: 13.5px;
    fill: var(--ink-3);
  }

  .pod__way {
    font-family: var(--mono);
    font-size: 12.5px;
    fill: var(--ink-2);
  }

  .pod__way--live {
    fill: var(--copper);
  }

  .pod__way--kill {
    fill: var(--red);
  }

  .pod__caps {
    font-family: var(--serif);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--ink-3);
  }

  /* Drawn smaller than its own units, the lettering steps up so it stays readable. */
  @media (max-width: 74rem) {
    .pod__name {
      font-size: 20.5px;
    }

    .pod__note {
      font-size: 15.5px;
    }

    .pod__way {
      font-size: 14px;
    }

    .pod__caps {
      font-size: 13.5px;
    }
  }

  /* A point of light on the paths work travels: out to the referee and back, and round the loop. */
  .pod__run {
    fill: none;
    stroke: var(--copper);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-dasharray: 0.001 1;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pod__agent {
      animation: pod-breathe calc(2.6s + var(--k) * 0.7s) ease-in-out calc(var(--k) * -1.1s) infinite alternate;
    }

    .pod__run {
      animation: pod-run 5.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    .pod__run--back {
      animation-delay: 1.4s;
    }

    .pod__run--loop {
      animation-delay: 3s;
    }
  }

  @keyframes pod-breathe {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes pod-run {
    0% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    4%,
    21% {
      opacity: 1;
    }
    25% {
      stroke-dashoffset: -1;
      opacity: 0;
    }
    100% {
      stroke-dashoffset: -1;
      opacity: 0;
    }
  }
</style>
