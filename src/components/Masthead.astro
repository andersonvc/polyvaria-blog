---
import wordmarkFile from "../../public/brand/polyvaria-wordmark.svg?raw";
import Mark from "./Mark.astro";
import { NAV } from "../content/site";

interface Props {
  nav?: boolean;
}

const { nav = true } = Astro.props;

/* The wordmark is the brand's outlined artwork, not live type, so it
   is identical everywhere. Only its ink is taken from the page. */
const outline = wordmarkFile.match(/<g\b[\s\S]*<\/g>/)?.[0].replace(/\sfill="[^"]*"/g, "") ?? "";
---

<header class="wrap masthead">
  <a class="masthead__brand" href="/" aria-label="Polyvaria, top of page">
    <Mark size={28} />
    <svg class="masthead__name" viewBox="0 0 164 41" role="img" aria-label="Polyvaria" set:html={outline} />
  </a>
  {
    nav && (
      <nav aria-label="Sections">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

<style>
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.6rem;
  }

  .masthead__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    text-decoration: none;
  }

  .masthead__brand:hover {
    color: var(--ink);
  }

  .masthead__name {
    height: 1.8rem;
    width: auto;
    fill: currentColor;
  }

  ul {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.2rem);
  }

  nav a {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.11em;
    font-size: 0.95rem;
    color: var(--ink-3);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
  }

  @media (max-width: 52rem) {
    nav {
      display: none;
    }
  }
</style>
