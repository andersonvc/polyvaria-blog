---
/*
  The firm, live: six distinct departments and the work that passes
  between them. Research is pods of agents round one central node; every
  other department is three separate graphs of agents (lib/swarms.ts).
  The figure plays one hypothesis from the idea to the book
  (lib/departments.ts): a point of light crosses from one department to
  the next, and the department that receives it turns copper and sets
  one of its graphs running. The story is told in the figure's hidden
  caption for readers who cannot see it.

  It fills whatever box it is put in. A still drawing of the six
  departments is rendered at build time; with script, a canvas takes
  over and the firm moves.
*/
import { DEPARTMENTS, LINKS, RING, STORY, TILT, restMarks, restPath } from "../lib/departments";

interface Props {
  /** hold the figure on one beat of the story, for the share card */
  beat?: number;
}

const { beat } = Astro.props;
const lit = beat !== undefined ? STORY[beat]!.at : -1;
---

<figure class="field" data-firm data-beat={beat}>
  <canvas class="field__live" aria-hidden="true"></canvas>

  <svg class="field__paths" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {LINKS.map(([a, b]) => <line x1={DEPARTMENTS[a]!.x * 100} y1={DEPARTMENTS[a]!.y * 100} x2={DEPARTMENTS[b]!.x * 100} y2={DEPARTMENTS[b]!.y * 100} />)}
  </svg>

  <ul class="field__depts">
    {
      DEPARTMENTS.map((d, i) => (
        <li class:list={{ "is-now": i === lit, "is-above": d.above, "is-graph": d.style === "dags" }} data-name={i} style={`--x:${d.x};--y:${d.y};--r:${d.r}`}>
          <svg class="field__still" viewBox={`-1 ${-TILT} 2 ${2 * TILT}`} aria-hidden="true">
            <ellipse class="field__ring" rx={RING} ry={RING * TILT} />
            <path class="field__edges" d={restMarks(i).edges} />
            <path class="field__lights" d={restPath(i)} />
            <path class="field__lights field__lights--lead" d={restMarks(i).core} />
          </svg>
          <span class="field__name">{d.name}</span>
        </li>
      ))
    }
  </ul>

  <figcaption class="visually-hidden">
    Six separate departments, each drawn as its own disk of lights: Onboarding, Research, HDS and Backtesting, Risk, Portfolio
    Management and Execution. Work passes between them one handoff at a time. {STORY.map((b) => b.text).join(" ")}
  </figcaption>
</figure>

<style>
  .field {
    position: relative;
    width: 100%;
    height: 100%;
    /* the figure arranges itself by the size of its own box, not the screen's */
    container-type: size;
  }

  .field__live {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }

  .field.is-live .field__live {
    display: block;
  }

  .field__depts li {
    position: absolute;
    left: calc(var(--x) * 100%);
    top: calc(var(--y) * 100%);
    width: 0;
    height: 0;
  }

  /* The still drawing of one department, centred on its place. */
  .field__still {
    position: absolute;
    left: calc(var(--r) * -100cqmin);
    top: calc(var(--r) * var(--tilt) * -100cqmin);
    width: calc(var(--r) * 200cqmin);
    height: calc(var(--r) * var(--tilt) * 200cqmin);
    max-width: none;
    overflow: visible;
  }

  .field {
    --tilt: 0.62;
  }

  .field.is-live .field__still,
  .field.is-live .field__paths {
    visibility: hidden;
  }

  /* The paths between departments, in the still drawing: centre to centre, under the disks. */
  .field__paths {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .field__paths line {
    stroke: var(--ink-3);
    stroke-width: 1px;
    stroke-dasharray: 2 5;
    vector-effect: non-scaling-stroke;
  }

  .field__lights {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.3px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.62;
  }

  /* an agent in a graph is drawn larger than one in a pod, and so is a pod's principal investigator */
  .is-graph .field__lights,
  .field__lights--lead {
    stroke-width: 4px;
    opacity: 0.8;
  }

  .field__edges {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .field__ring {
    fill: var(--paper);
    stroke: var(--rule);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .is-now .field__lights {
    stroke: var(--copper);
    opacity: 0.9;
  }

  .is-now .field__ring {
    stroke: var(--copper-mark);
  }

  /* A department's name, set under it. */
  .field__name {
    position: absolute;
    left: 0;
    top: calc(var(--r) * var(--tilt) * 113cqmin + 0.7rem);
    transform: translateX(-50%);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.14em;
    font-size: 0.9rem;
    line-height: 1;
    white-space: nowrap;
    color: var(--ink-2);
    transition: color 0.5s ease;
  }

  .is-now .field__name {
    color: var(--copper);
  }

  .is-above .field__name {
    top: auto;
    bottom: calc(var(--r) * var(--tilt) * 113cqmin + 0.7rem);
  }

  @container (max-width: 34rem) {
    .field__name {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      top: calc(var(--r) * var(--tilt) * 113cqmin + 0.45rem);
    }

    .is-above .field__name {
      top: auto;
      bottom: calc(var(--r) * var(--tilt) * 113cqmin + 0.45rem);
    }

    .field__lights {
      stroke-width: 1.5px;
    }
  }
</style>

<script>
  import { BEAT, DEPARTMENTS, LINKS, RING, STORY, TILT, swarmOf } from "../lib/departments";

  const root = document.querySelector<HTMLElement>("[data-firm]");
  const canvas = root?.querySelector<HTMLCanvasElement>("canvas");
  const ctx = canvas?.getContext("2d");

  if (root && canvas && ctx) {
    const held = root.dataset.beat !== undefined ? Number(root.dataset.beat) : null;
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const moving = held === null && !calm;

    const names = [...root.querySelectorAll<HTMLElement>("[data-name]")];

    const N = DEPARTMENTS.length;
    const swarms = DEPARTMENTS.map((_, d) => swarmOf(d));
    const most = Math.max(...swarms.map((s) => s.count));
    /* working arrays, reused every frame */
    const scratch = { xs: new Float32Array(most), ys: new Float32Array(most), rs: new Float32Array(most), level: new Uint8Array(most) };
    const INK = [236, 231, 220] as const;
    const COPPER = [224, 186, 130] as const;
    const LEVELS = 8;

    /* ── the box ── */
    let w = 1;
    let h = 1;
    let base = 1;
    let dpr = 1;
    let dot = 1.3;
    const size = (): void => {
      const box = root.getBoundingClientRect();
      dpr = Math.min(2, window.devicePixelRatio || 1);
      w = Math.max(1, Math.round(box.width));
      h = Math.max(1, Math.round(box.height));
      base = Math.min(w, h);
      dot = 0.75 + 0.6 * Math.min(1, base / 760);
      canvas.width = w * dpr;
      canvas.height = h * dpr;
    };
    const cx = (d: number): number => DEPARTMENTS[d]!.x * w;
    const cy = (d: number): number => DEPARTMENTS[d]!.y * h;
    const rad = (d: number): number => DEPARTMENTS[d]!.r * base;

    /** Where the path between two departments leaves the first and reaches the second. */
    const span = (a: number, b: number): [number, number, number, number] => {
      const ang = Math.atan2((cy(b) - cy(a)) / TILT, cx(b) - cx(a));
      const c = Math.cos(ang);
      const s = Math.sin(ang);
      return [cx(a) + rad(a) * RING * c, cy(a) + rad(a) * RING * s * TILT, cx(b) - rad(b) * RING * c, cy(b) - rad(b) * RING * s * TILT];
    };

    /* ── the story ── */
    interface Leg {
      from: number;
      to: number;
      start: number;
      end: number;
    }
    const legsOf = (index: number): Leg[] => {
      const beat = STORY[index]!;
      const n = beat.legs.length;
      return beat.legs.map(([from, to], i) => {
        if (beat.together || n === 1) return { from, to, start: 0.07, end: 0.47 };
        const each = 0.27;
        return { from, to, start: 0.06 + i * each, end: 0.06 + (i + 1) * each };
      });
    };
    const schedule = STORY.map((_, i) => legsOf(i));

    const glow = new Float32Array(N);
    const want = new Float32Array(N);
    let fired = new Set<string>();
    let shown = -1;
    let clock = held !== null ? held * BEAT + 0.4 * BEAT : 0;
    const lit = new Array<boolean>(N).fill(false);

    const ease = (q: number): number => (q < 0.5 ? 2 * q * q : 1 - (-2 * q + 2) ** 2 / 2);

    /* ── one frame ── */
    const draw = (t: number, dt: number): void => {
      const index = ((Math.floor(clock / BEAT) % STORY.length) + STORY.length) % STORY.length;
      const p = (clock % BEAT) / BEAT;
      const beat = STORY[index]!;
      const legs = schedule[index]!;
      const active = moving || held !== null;

      if (active && index !== shown) {
        shown = index;
        fired = new Set();
      }

      /* who is lit: the sender, then the receiver, then whoever does the work */
      want.fill(0);
      if (active) {
        const lastEnd = legs.length ? Math.max(...legs.map((l) => l.end)) : 0;
        for (const [i, leg] of legs.entries()) {
          const q = (p - leg.start) / (leg.end - leg.start);
          if (q < 0) {
            want[leg.from] = Math.max(want[leg.from]!, 0.75);
          } else if (q <= 1) {
            want[leg.from] = Math.max(want[leg.from]!, 1 - 0.55 * q);
            want[leg.to] = Math.max(want[leg.to]!, 0.3 + 0.7 * q);
          } else {
            want[leg.to] = Math.max(want[leg.to]!, leg.to === beat.at ? 1 : 0.55);
            const key = `${index}:${i}`;
            /* work has arrived: the department that received it sets one of its graphs running */
            if (moving && !fired.has(key)) {
              fired.add(key);
              swarms[leg.to]!.fire();
            }
          }
        }
        if (p >= lastEnd) want[beat.at] = 1;
        if (moving && legs.length === 0) {
          const key = `${index}:work`;
          if (p > 0.06 && !fired.has(key)) {
            fired.add(key);
            swarms[beat.at]!.fire();
          }
        }
        if (p > 0.93) for (let d = 0; d < N; d++) want[d] = want[d]! * ((1 - p) / 0.07);
      }
      const k = moving ? 1 - Math.exp(-dt * 6) : 1;
      for (let d = 0; d < N; d++) {
        glow[d] = glow[d]! + (want[d]! - glow[d]!) * k;
        const on = glow[d]! > 0.45;
        if (on !== lit[d]) {
          lit[d] = on;
          names[d]?.classList.toggle("is-now", on);
        }
      }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      /* the paths between departments, always there, faint */
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 5]);
      ctx.strokeStyle = `rgb(${INK.join(" ")} / 0.36)`;
      ctx.beginPath();
      for (const [a, b] of LINKS) {
        const [x0, y0, x1, y1] = span(a, b);
        ctx.moveTo(x0, y0);
        ctx.lineTo(x1, y1);
      }
      ctx.stroke();
      ctx.setLineDash([]);
      /* a door at each end: the one place on a department's boundary where this path is let through */
      ctx.fillStyle = `rgb(${INK.join(" ")} / 0.55)`;
      ctx.beginPath();
      for (const [a, b] of LINKS) {
        const [x0, y0, x1, y1] = span(a, b);
        ctx.moveTo(x0 + 2.2 * dot, y0);
        ctx.arc(x0, y0, 2.2 * dot, 0, 6.2832);
        ctx.moveTo(x1 + 2.2 * dot, y1);
        ctx.arc(x1, y1, 2.2 * dot, 0, 6.2832);
      }
      ctx.fill();

      /* work in transit */
      if (active) {
        for (const leg of legs) {
          const q = (p - leg.start) / (leg.end - leg.start);
          if (q < 0 || q > 1) continue;
          const [x0, y0, x1, y1] = span(leg.from, leg.to);
          const e = ease(q);
          const hx = x0 + (x1 - x0) * e;
          const hy = y0 + (y1 - y0) * e;
          const back = Math.max(0, e - 0.34);
          const tx = x0 + (x1 - x0) * back;
          const ty = y0 + (y1 - y0) * back;
          const show = Math.min(1, q * 8, (1 - q) * 8);

          ctx.strokeStyle = `rgb(${COPPER.join(" ")} / ${(0.32 * show).toFixed(3)})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(x0, y0);
          ctx.lineTo(x1, y1);
          ctx.stroke();

          const trail = ctx.createLinearGradient(tx, ty, hx, hy);
          trail.addColorStop(0, `rgb(${COPPER.join(" ")} / 0)`);
          trail.addColorStop(1, `rgb(${COPPER.join(" ")} / ${show.toFixed(3)})`);
          ctx.strokeStyle = trail;
          ctx.lineWidth = 2 * dot;
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(tx, ty);
          ctx.lineTo(hx, hy);
          ctx.stroke();

          const halo = ctx.createRadialGradient(hx, hy, 0, hx, hy, 14 * dot);
          halo.addColorStop(0, `rgb(${COPPER.join(" ")} / ${(0.55 * show).toFixed(3)})`);
          halo.addColorStop(1, `rgb(${COPPER.join(" ")} / 0)`);
          ctx.fillStyle = halo;
          ctx.beginPath();
          ctx.arc(hx, hy, 14 * dot, 0, 6.2832);
          ctx.fill();
          ctx.fillStyle = `rgb(${COPPER.join(" ")} / ${show.toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(hx, hy, 2.6 * dot, 0, 6.2832);
          ctx.fill();
        }
      }

      /* the departments */
      for (let d = 0; d < N; d++) {
        const g = glow[d]!;
        const x = cx(d);
        const y = cy(d);
        const r = rad(d);
        const rgb = `${Math.round(INK[0] + (COPPER[0] - INK[0]) * g)} ${Math.round(INK[1] + (COPPER[1] - INK[1]) * g)} ${Math.round(INK[2] + (COPPER[2] - INK[2]) * g)}`;

        if (g > 0.02) {
          ctx.save();
          ctx.translate(x, y);
          ctx.scale(1, TILT);
          const wash = ctx.createRadialGradient(0, 0, r * 0.2, 0, 0, r * 1.7);
          wash.addColorStop(0, `rgb(${COPPER.join(" ")} / ${(0.15 * g).toFixed(3)})`);
          wash.addColorStop(1, `rgb(${COPPER.join(" ")} / 0)`);
          ctx.fillStyle = wash;
          ctx.beginPath();
          ctx.arc(0, 0, r * 1.7, 0, 6.2832);
          ctx.fill();
          ctx.restore();
        }

        ctx.strokeStyle = `rgb(${rgb} / ${(0.2 + 0.55 * g).toFixed(3)})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.ellipse(x, y, r * RING, r * RING * TILT, 0, 0, 6.2832);
        ctx.stroke();

        /* the agents inside: Research in separate pods, every other department as graphs run in sequence */
        const crowd = swarms[d]!;
        if (moving) crowd.step(t, dt);
        else crowd.step(6.5, 0);

        /* the edges of the graphs, and the work travelling along them */
        const edges = crowd.edges;
        if (edges.length) {
          ctx.lineWidth = 1;
          ctx.lineCap = "round";
          for (let e = 0; e < edges.length; e += 2) {
            const a = edges[e]!;
            const b = edges[e + 1]!;
            const lit = crowd.edgeLit[e / 2]!;
            ctx.strokeStyle = `rgb(${rgb} / ${(0.2 + 0.6 * lit).toFixed(3)})`;
            ctx.beginPath();
            ctx.moveTo(x + r * crowd.x[a]!, y + r * crowd.y[a]! * TILT);
            ctx.lineTo(x + r * crowd.x[b]!, y + r * crowd.y[b]! * TILT);
            ctx.stroke();
          }
          ctx.fillStyle = `rgb(${rgb} / 0.95)`;
          ctx.beginPath();
          for (let e = 0; e < edges.length; e += 2) {
            const run = crowd.edgeRun[e / 2]!;
            if (run < 0) continue;
            const a = edges[e]!;
            const b = edges[e + 1]!;
            const px = x + r * (crowd.x[a]! + (crowd.x[b]! - crowd.x[a]!) * run);
            const py = y + r * (crowd.y[a]! + (crowd.y[b]! - crowd.y[a]!) * run) * TILT;
            ctx.moveTo(px + 1.2 * dot, py);
            ctx.arc(px, py, 1.2 * dot, 0, 6.2832);
          }
          ctx.fill();
        }

        /* one node at the centre of the department, and a line from it to the centre of every pod */
        if (crowd.core) {
          ctx.strokeStyle = `rgb(${rgb} / 0.32)`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          for (const hub of crowd.hubs) {
            ctx.moveTo(x, y);
            ctx.lineTo(x + r * hub.x, y + r * hub.y * TILT);
          }
          ctx.stroke();
          ctx.fillStyle = `rgb(${rgb} / 1)`;
          ctx.beginPath();
          ctx.arc(x, y, 3.4 * dot, 0, 6.2832);
          ctx.fill();
        }

        const n = crowd.count;
        /* a department at work turns copper; only the few agents of a graph also brighten, so a large
           swarm never flares all at once */
        const flare = crowd.steady ? 1 + 0.55 * g : 1;
        const xs = scratch.xs;
        const ys = scratch.ys;
        const rs = scratch.rs;
        const level = scratch.level;

        for (let i = 0; i < n; i++) {
          const lx = crowd.x[i]!;
          const ly = crowd.y[i]!;
          const front = Math.max(0, Math.min(1, ly * 0.5 + 0.5));
          const lift = crowd.lift[i]!;
          /* an agent in a graph burns steadily and brightens when its stage runs; one in a pod flickers on its own */
          const pulse = 0.5 + 0.5 * Math.sin(t * crowd.rate[i]! + crowd.phase[i]!);
          const rest = crowd.steady ? 0.4 + 0.6 * lift : 0.38 + 0.44 * pulse * pulse;
          const alpha = Math.min(1, rest * (0.78 + 0.22 * front) * flare);
          xs[i] = x + r * lx;
          ys[i] = y + r * ly * TILT;
          rs[i] = dot * crowd.scale * (0.82 + 0.3 * front) * (1 + 0.25 * lift);
          level[i] = Math.min(LEVELS - 1, Math.floor(alpha * LEVELS));
        }

        for (let l = 0; l < LEVELS; l++) {
          ctx.fillStyle = `rgb(${rgb} / ${((l + 0.75) / LEVELS).toFixed(3)})`;
          ctx.beginPath();
          for (let i = 0; i < n; i++) {
            if (level[i] !== l) continue;
            ctx.moveTo(xs[i]! + rs[i]!, ys[i]!);
            ctx.arc(xs[i]!, ys[i]!, rs[i]!, 0, 6.2832);
          }
          ctx.fill();
        }
      }
    };

    /* ── run ── */
    size();
    new ResizeObserver(() => {
      size();
      if (!moving) draw(0, 0);
    }).observe(root);

    if (moving) {
      let visible = true;
      /* The first frame's timestamp can be a moment earlier than the clock read here, so time is
         measured from the first frame itself and a step is never allowed to be negative. */
      let last = -1;
      let elapsed = 0;
      const frame = (ms: number): void => {
        /* ask for the next frame first, so one bad frame can never stop the figure */
        requestAnimationFrame(frame);
        const dt = last < 0 ? 0 : Math.max(0, Math.min(0.05, (ms - last) / 1000));
        last = ms;
        if (visible && !document.hidden) {
          clock += dt;
          elapsed += dt;
          draw(elapsed, dt);
        }
      };
      new IntersectionObserver((entries) => (visible = entries[0]?.isIntersecting ?? true)).observe(root);
      draw(0, 0);
      root.classList.add("is-live");
      requestAnimationFrame(frame);
    } else {
      draw(0, 0);
      root.classList.add("is-live");
    }
  }
</script>
