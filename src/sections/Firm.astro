---
import FirmPlan from "../components/FirmPlan.astro";

/* The pipeline the six departments run, a line each. */
const PIPELINE = [
  { stage: "Universe", text: "Point-in-time by construction. About 2,400 names, delistings included, sixteen years deep." },
  { stage: "Alpha", text: "58 signals across price, events, analysts, news, ownership and fundamentals as first filed." },
  { stage: "Model", text: "Gradient-boosted blends at one-, three- and six-month horizons. Walk-forward, purged and embargoed." },
  { stage: "Risk", text: "A Barra-grade factor model: seven styles, 31 industries, re-estimated daily, built without sight of the alpha." },
  { stage: "Book", text: "A constrained conic solve. Alpha net of active risk and trading cost. Any day replays exactly." },
  { stage: "Execution", text: "Every order knows its urgency. Realized cost feeds the next solve." },
];
---

<section class="screen" id="firm" aria-labelledby="firm-title">
  <div class="wrap stack">
    <div class="head" data-reveal>
      <div>
        <p class="label screen__label"><span class="mono">03</span> The firm</p>
        <h2 class="claim" id="firm-title">Six departments. <em>Zero</em> employees.</h2>
      </div>
      <p class="lede">
        A pod never touches the referee, the risk model or the book. Each department runs itself, builds its own tools, and
        meets the others only at interfaces neither side can change alone.
      </p>
    </div>

    <FirmPlan />

    <ol class="pipe" data-reveal aria-label="The pipeline, stage by stage">
      {
        PIPELINE.map((cell) => (
          <li>
            <span class="pipe__stage mono">{cell.stage}</span>
            <span class="pipe__text">{cell.text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .claim em {
    font-style: normal;
    color: var(--copper);
  }

  /* The pipeline: one ruled strip, a cell a stage, a chevron where one hands to the next. */
  .pipe {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .pipe li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.85rem 1.05rem 0.95rem;
    border-left: 1px solid var(--rule);
  }

  .pipe li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .pipe li + li::before {
    content: "";
    position: absolute;
    left: -0.3rem;
    top: 1.02rem;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 1px solid var(--copper-mark);
    border-right: 1px solid var(--copper-mark);
    background: var(--paper);
    transform: rotate(45deg);
  }

  .pipe__stage {
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--copper-mark);
  }

  .pipe__text {
    font-size: 0.82rem;
    line-height: 1.42;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (min-width: 74.01rem) and (max-height: 52rem) {
    .pipe li {
      gap: 0.3rem;
      padding-block: 0.6rem 0.65rem;
    }

    .pipe li + li::before {
      top: 0.78rem;
    }

    .pipe__text {
      font-size: 0.78rem;
      line-height: 1.38;
    }
  }

  @media (max-width: 74rem) {
    .pipe {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pipe li:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }

    .pipe li:nth-child(3n + 1)::before {
      display: none;
    }

    .pipe li:nth-child(n + 4) {
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 40rem) {
    .pipe {
      grid-template-columns: minmax(0, 1fr);
    }

    .pipe li,
    .pipe li:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .pipe li + li {
      border-top: 1px solid var(--rule);
    }

    .pipe li + li::before {
      display: none;
    }
  }
</style>
